<section id="cookbook" class="cookbook">
  <div class="cookbook-head">
    <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title">{{ section.settings.title }}</h2>
  </div>

  <div class="recipes-grid">
    {%- if section.settings.blog != blank -%}
      {%- assign cookbook_blog = blogs[section.settings.blog] -%}

      {%- for article in cookbook_blog.articles limit: section.settings.articles_to_show -%}
        {%- assign prep      = article.metafields.recipe.prep_time -%}
        {%- assign cook      = article.metafields.recipe.cook_time -%}
        {%- assign meal_type = article.metafields.recipe.meal_type -%}

        {%- if prep != blank and cook != blank -%}
          {%- assign time_display = prep | append: ' + ' | append: cook -%}
        {%- elsif prep != blank -%}
          {%- assign time_display = prep -%}
        {%- elsif cook != blank -%}
          {%- assign time_display = cook -%}
        {%- else -%}
          {%- assign time_display = '' -%}
        {%- endif -%}

        {%- if meal_type == blank -%}
          {%- assign meal_type = article.tags | last -%}
        {%- endif -%}

        {%- assign primary_tag = article.tags | first -%}

        <div class="recipe-card reveal">
          <div class="recipe-img">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 800, crop: 'center' }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                width="800" height="600"
                loading="lazy"
                class="recipe-img-tag"
              />
            {%- else -%}
              <div class="recipe-img-placeholder r{{ forloop.index }}">
                {%- if primary_tag != blank -%}
                  <span class="recipe-tag">{{ primary_tag }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if article.image and primary_tag != blank -%}
              <span class="recipe-tag">{{ primary_tag }}</span>
            {%- endif -%}
          </div>
          <div class="recipe-info">
            {%- if time_display != blank or meal_type != blank -%}
              <div class="recipe-meta">
                {{ time_display }}
                {%- if time_display != blank and meal_type != blank -%}&nbsp;&middot;&nbsp;{%- endif -%}
                {{ meal_type }}
              </div>
            {%- endif -%}
            <div class="recipe-name">{{ article.title }}</div>
            {%- if article.excerpt != blank -%}
              <div class="recipe-preview">{{ article.excerpt | strip_html | truncate: 120 }}</div>
            {%- elsif article.content != blank -%}
              <div class="recipe-preview">{{ article.content | strip_html | truncate: 120 }}</div>
            {%- endif -%}
            <a href="{{ article.url }}" class="recipe-link">Get the Recipe</a>
          </div>
        </div>
      {%- endfor -%}

    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'recipe' -%}
          <div class="recipe-card reveal" {{ block.shopify_attributes }}>
            <div class="recipe-img">
              {%- if block.settings.image -%}
                <img
                  src="{{ block.settings.image | image_url: '800x600', crop: 'center' }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="800" height="600"
                  loading="lazy"
                  class="recipe-img-tag"
                />
              {%- else -%}
                <div class="recipe-img-placeholder r{{ forloop.index }}">
                  <span class="recipe-tag">{{ block.settings.tag }}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.image and block.settings.tag != blank -%}
                <span class="recipe-tag">{{ block.settings.tag }}</span>
              {%- endif -%}
            </div>
            <div class="recipe-info">
              <div class="recipe-meta">{{ block.settings.time }} &nbsp;&middot;&nbsp; {{ block.settings.meal_type }}</div>
              <div class="recipe-name">{{ block.settings.name }}</div>
              {%- if block.settings.preview != blank -%}
                <div class="recipe-preview">{{ block.settings.preview }}</div>
              {%- endif -%}
              {%- if block.settings.link_url != blank -%}
                <a href="{{ block.settings.link_url }}" class="recipe-link">Get the Recipe</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.blog != blank and section.settings.show_view_all -%}
    {%- assign cookbook_blog = blogs[section.settings.blog] -%}
    <div class="cookbook-footer">
      <a href="{{ cookbook_blog.url }}" class="btn-ghost">{{ section.settings.view_all_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cookbook",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Cookbook"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Cook with Pizca"
    },
    {
      "type": "header",
      "content": "Blog source"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Select a blog to pull recipes from. When set, manual recipe blocks below are ignored."
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Recipes to show",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All Recipes"
    }
  ],
  "blocks": [
    {
      "type": "recipe",
      "name": "Recipe (manual fallback)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Recipe image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (e.g. Featured, Quick)",
          "default": "Featured Recipe"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Recipe name",
          "default": "Chile Oil Fried Eggs"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time",
          "default": "15 min"
        },
        {
          "type": "text",
          "id": "meal_type",
          "label": "Meal type",
          "default": "Breakfast"
        },
        {
          "type": "textarea",
          "id": "preview",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Recipe page URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cookbook",
      "blocks": [
        { "type": "recipe", "settings": { "name": "Chile Oil Fried Eggs with Crispy Shallots", "time": "15 min", "meal_type": "Breakfast", "tag": "Featured Recipe" } },
        { "type": "recipe", "settings": { "name": "Seared Scallops, Verde Oil & Corn", "time": "30 min", "meal_type": "Dinner", "tag": "Quick" } },
        { "type": "recipe", "settings": { "name": "Chile Oil Focaccia with Whipped Ricotta", "time": "45 min", "meal_type": "Snacks", "tag": "Weekend" } }
      ]
    }
  ]
}
{% endschema %}
