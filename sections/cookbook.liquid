<section id="cookbook" class="cookbook">
  <div class="cookbook-head">
    <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title">{{ section.settings.title }}</h2>
  </div>

  <div class="recipes-grid">
    {%- if section.settings.blog != blank -%}
      {%- assign cookbook_blog = blogs[section.settings.blog] -%}
      {%- for article in cookbook_blog.articles limit: section.settings.articles_to_show -%}
        {%- render 'article-card', article: article -%}
      {%- endfor -%}
    {%- else -%}
      <div class="blog-empty">
        <p>No recipes yet — check back soon.</p>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.blog != blank and section.settings.show_view_all -%}
    {%- assign cookbook_blog = blogs[section.settings.blog] -%}
    <div class="cookbook-footer">
      <a href="{{ cookbook_blog.url }}" class="btn-ghost">{{ section.settings.view_all_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cookbook",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Cookbook"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Cook with Pizca"
    },
    {
      "type": "header",
      "content": "Blog source"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Select a blog to pull recipes from. When set, manual recipe blocks below are ignored."
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Recipes to show",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All Recipes"
    }
  ],
  "presets": [
    { "name": "Cookbook" }
  ]
}
{% endschema %}
