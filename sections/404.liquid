<section class="not-found">
  <div class="not-found__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 700 }}"
        alt="{{ section.settings.image.alt | escape }}"
        class="not-found__image"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
      />
    {%- else -%}
      <div class="not-found__placeholder">
        {{ 'image' | placeholder_svg_tag: 'not-found__placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="not-found__content">
    <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="not-found__heading">{{ section.settings.heading }}</h1>
    <p class="not-found__message">{{ section.settings.message }}</p>
    <a href="{{ section.settings.button_link | default: '/' }}" class="not-found__button">
      {{ section.settings.button_label }}
    </a>
  </div>
</section>

{% style %}
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    padding: 6rem 2rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .not-found {
      flex-direction: row;
      text-align: left;
      padding: 8rem 4rem;
      max-width: 1200px;
      margin: 0 auto;
    }
  }

  .not-found__media {
    flex: 1;
    max-width: 480px;
    width: 100%;
  }

  .not-found__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    border-radius: 4px;
  }

  .not-found__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #f4f4f4;
    border-radius: 4px;
    overflow: hidden;
  }

  .not-found__placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .not-found__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .not-found__heading {
    font-size: 3rem;
    margin: 0;
  }

  .not-found__message {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0;
  }

  .not-found__button {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.75rem 2rem;
    background-color: currentColor;
    color: inherit;
    text-decoration: none;
    border: 1px solid currentColor;
    transition: opacity 0.2s;
  }

  .not-found__button:hover {
    opacity: 0.75;
  }
{% endstyle %}

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Error 404"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "The page you're looking for doesn't exist or has been moved."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Back to home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "404 Page"
    }
  ]
}
{% endschema %}
