<footer>
  <div class="footer-top">

    <div class="footer-brand">
      <a href="{{ routes.root_url }}" class="logo">
        {%- if section.settings.logo_image != blank -%}
          <img
            src="{{ section.settings.logo_image | image_url: width: 300 }}"
            alt="{{ section.settings.logo_image.alt | default: shop.name | escape }}"
            class="logo-image-tag"
            width="{{ section.settings.logo_image.width }}"
            height="{{ section.settings.logo_image.height }}"
            loading="eager"
          />
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
      <p class="footer-tagline">{{ section.settings.tagline }}</p>
      <p>{{ section.settings.description }}</p>

      {%- if section.settings.instagram_url != blank or section.settings.facebook_url != blank -%}
        <ul class="footer-social" role="list">
          {%- if section.settings.instagram_url != blank -%}
            <li>
              <a href="{{ section.settings.instagram_url }}" class="footer-social-link" aria-label="{{ 'sections.footer.social.instagram' | t }}" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
                  <rect x="2.5" y="2.5" width="19" height="19" rx="5"></rect>
                  <circle cx="12" cy="12" r="4.5"></circle>
                  <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"></circle>
                </svg>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <li>
              <a href="{{ section.settings.facebook_url }}" class="footer-social-link" aria-label="{{ 'sections.footer.social.facebook' | t }}" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
                  <path d="M15.5 8.5h-2a1 1 0 0 0-1 1V12h3l-.4 3h-2.6v7h-3v-7H7.5v-3h2V9.2c0-2.3 1.4-3.7 3.6-3.7h2.4v3z"></path>
                </svg>
              </a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu_column' -%}
        <div class="footer-col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}
    

  </div>

  <div class="footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      &nbsp;&middot;&nbsp;
      <a href="{{ "/policies/privacy-policy"  | default: '#' }}">Privacy</a>
      &nbsp;&middot;&nbsp;
      <a href="{{ "/policies/terms-of-service" | default: '#' }}">Terms</a>
    </p>
    <div class="payment-icons">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'payment-icon' }}
      {%- endfor -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer-social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: currentColor;
    transition: opacity 0.15s ease;
  }

  .footer-social-link:hover,
  .footer-social-link:focus-visible {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Chile in oil. Made the traditional way."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand description",
      "default": "Small batch, hand-crafted chile in oil made in Michigan, USA. No preservatives. No shortcuts. Just flavorful fire."
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "header",
      "content": "t:sections.footer.social.header"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:sections.footer.social.instagram"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "t:sections.footer.social.facebook"
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu_column", "settings": { "heading": "Shop" } },
        { "type": "menu_column", "settings": { "heading": "Explore" } },
        { "type": "menu_column", "settings": { "heading": "Help" } }
      ]
    }
  ]
}
{% endschema %}
