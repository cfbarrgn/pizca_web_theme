<section class="contact-section">
  <div class="contact-inner">
    <div class="contact-header">
      <p class="section-eyebrow">{{ section.settings.eyebrow | default: 'Get in Touch' }}</p>
      <h1 class="contact-title">{{ section.settings.heading | default: 'Contact Us' }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="contact-subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    {%- if form.posted_successfully? -%}
      <div class="contact-success">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <p>{{ section.settings.success_message | default: "Thank you! We'll be in touch soon." }}</p>
      </div>
    {%- else -%}
      {%- form 'contact' -%}
        {%- if form.errors -%}
          <div class="contact-errors">
            {%- for field in form.errors -%}
              <p>{{ field | capitalize }}: {{ form.errors.messages[field] }}</p>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="contact-form-grid">
          <div class="contact-field">
            <label for="ContactFormName" class="contact-label">Name</label>
            <input
              type="text"
              id="ContactFormName"
              name="contact[name]"
              class="contact-input"
              value="{{ form.name }}"
              autocomplete="name"
              required
            />
          </div>

          <div class="contact-field">
            <label for="ContactFormEmail" class="contact-label">Email</label>
            <input
              type="email"
              id="ContactFormEmail"
              name="contact[email]"
              class="contact-input"
              value="{{ form.email }}"
              autocomplete="email"
              required
            />
          </div>

          <div class="contact-field contact-field--full">
            <label for="ContactFormMessage" class="contact-label">Message</label>
            <textarea
              id="ContactFormMessage"
              name="contact[body]"
              class="contact-input contact-textarea"
              rows="6"
              required
            >{{ form.body }}</textarea>
          </div>

          <div class="contact-field contact-field--full">
            <button type="submit" class="btn-primary contact-submit">Send Message</button>
          </div>
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

<style>
  .contact-section {
    padding: 80px 64px;
    background: var(--color-crema);
  }
  .contact-inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .contact-header {
    margin-bottom: 48px;
  }
  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 900;
    color: var(--color-dark-earth);
    margin-top: 12px;
    margin-bottom: 0;
  }
  .contact-subtext {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 16px;
    color: var(--color-tobacco);
    line-height: 1.75;
    margin-top: 16px;
  }
  .contact-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .contact-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .contact-field--full {
    grid-column: 1 / -1;
  }
  .contact-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-tobacco);
  }
  .contact-input {
    width: 100%;
    padding: 14px 18px;
    background: var(--color-linen);
    border: 1px solid var(--color-sand);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-dark-earth);
    outline: none;
    transition: border-color 0.2s;
    border-radius: var(--radius-sm);
    -webkit-appearance: none;
  }
  .contact-input:focus {
    border-color: var(--color-chile-red);
  }
  .contact-textarea {
    resize: vertical;
    min-height: 140px;
  }
  .contact-submit {
    padding: 16px 40px;
    font-size: 12px;
    letter-spacing: 0.12em;
  }
  .contact-success {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 32px 36px;
    background: var(--color-linen);
    border: 1px solid var(--color-sand);
    border-left: 3px solid var(--color-forest);
    color: var(--color-forest);
    border-radius: var(--radius-sm);
  }
  .contact-success p {
    font-family: var(--font-display);
    font-size: 18px;
    font-style: italic;
    color: var(--color-dark-earth);
  }
  .contact-errors {
    background: var(--color-blush);
    border: 1px solid var(--color-chile-red);
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    margin-bottom: 24px;
    font-size: 13px;
    color: var(--color-dark-chile);
  }
  .contact-errors p { margin-bottom: 4px; }
  .contact-errors p:last-child { margin-bottom: 0; }

  @media (max-width: 640px) {
    .contact-section { padding: 60px 20px; }
    .contact-form-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Have a question about our hot sauces? We'd love to hear from you."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! We'll be in touch soon."
    }
  ],
  "presets": [
    { "name": "Contact Form" }
  ]
}
{% endschema %}
