<section class="password-page">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 1920 }}"
      alt="{{ section.settings.image.alt | escape }}"
      class="password-page__image"
      width="1920"
      height="1080"
    />
  {%- else -%}
    {{ 'image' | placeholder_svg_tag: 'password-page__placeholder' }}
  {%- endif -%}
</section>

{% style %}
  .password-page {
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
  .password-page__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .password-page__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }
{% endstyle %}

{% schema %}
{
  "name": "Password Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Password Page"
    }
  ]
}
{% endschema %}
