<div class="product-card reveal">
  <a href="{{ product.url }}" class="product-name-link">
  <div class="product-img-wrap">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width:300, crop: 'center' }}"
        alt="{{ product.featured_image.alt | escape }}"
        class="product-img"
        width="300"
        height="676"
        loading="lazy"
      />
    {%- else -%}
      <div class="product-img-placeholder bg-original">
        <div class="jar-wrap">
          <div class="jar j-original">
            <div class="jar-lid"></div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if product.available == false -%}
      <span class="product-badge sold">Sold Out</span>
    {%- elsif product.tags contains 'new' -%}
      <span class="product-badge new">New</span>
    {%- elsif product.tags contains 'best-seller' -%}
      <span class="product-badge">Best Seller</span>
    {%- endif -%}

    <form action="{{ routes.cart_add_url }}" method="post" class="quick-add-form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
      <input type="hidden" name="quantity" value="1" />
      <button type="submit" class="product-quick-add">
        + Add to Cart
      </button>
    </form>
  </div>

  <div class="product-info">
    <a href="{{ product.url }}" class="product-name-link">
      <div class="product-name">{{ product.title }}</div>
    </a>
    {%- assign heat = product.metafields.custom.heat_level | plus: 0 -%}
      {%- if heat > 0 -%}
        <div class="heat-bar" style="margin: 0 0 28px;">
          <span class="heat-label">Heat Level</span>
          <div class="heat-dots">
            {%- for i in (1..5) -%}
              <span class="heat-dot{% if i <= heat %} active{% endif %}"></span>
            {%- endfor -%}
          </div>
          <span class="heat-text">{{ product.metafields.custom.heat_label }}</span>
        </div>
    {%- endif -%}
    <!-- Start of Judge.me code --> 
    <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-auto-install="false">
      {{ product.metafields.judgeme.badge }}
    </div>
    <!-- End of Judge.me code -->
    {%- if product.metafields.custom.short_description != blank -%}
      <div class="product-desc">{{ product.metafields.custom.short_description }}</div>
    {%- elsif product.description != blank -%}
      <div class="product-desc">{{ product.description | strip_html | truncate: 200 }}</div>
    {%- endif -%}
    <div class="product-foot">
      <div class="product-price">
        {%- if product.compare_at_price > product.price -%}
          <span class="price-was">{{ product.compare_at_price | money }}</span>
          <span class="price-sale">{{ product.price | money }}</span>
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </div>
    </div>
  </div>
  </a>
</div>
